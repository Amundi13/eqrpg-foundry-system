<header class="sheet-header pet-header">
  <div class="portrait-frame pet-portrait-frame">
    <img class="profile-img" src="{{document.img}}" data-edit="img"
         title="{{document.name}}" />
  </div>
  <div class="header-details">
    <div class="pet-title-line">
      <h1 class="char-name">
        <input name="name" type="text" value="{{document.name}}"
               placeholder="{{localize 'EQRPG.PetName'}}"
               {{#unless isEditable}}disabled{{/unless}} />
      </h1>
      <span class="pet-sheet-badge">{{localize "EQRPG.Companion"}}</span>
    </div>

    <div class="header-fields pet-identity-fields">
      <div class="field-group">
        <label>{{localize "EQRPG.CompanionType"}}</label>
        <input type="text" name="system.companion.kind" value="{{system.companion.kind}}"
               placeholder="Skeletal Companion" {{#unless isEditable}}disabled{{/unless}} />
      </div>
      <div class="field-group">
        <label>{{localize "EQRPG.Master"}}</label>
        <input type="text" name="system.companion.masterName" value="{{system.companion.masterName}}"
               placeholder="Character name" {{#unless isEditable}}disabled{{/unless}} />
      </div>
      <div class="field-group compact">
        <label>{{localize "EQRPG.Size"}}</label>
        <input type="text" name="system.details.size" value="{{system.details.size}}"
               placeholder="Small" {{#unless isEditable}}disabled{{/unless}} />
      </div>
      <div class="field-group">
        <label>{{localize "EQRPG.Type"}}</label>
        <input type="text" name="system.details.type" value="{{system.details.type}}"
               placeholder="Undead" {{#unless isEditable}}disabled{{/unless}} />
      </div>
      {{#if isGM}}
      <div class="field-group pet-owner-field">
        <label>{{localize "EQRPG.PlayerController"}}</label>
        <select data-pet-owner-select>
          <option value="">{{localize "EQRPG.GMOnly"}}</option>
          {{#each petOwnerOptions as |owner|}}
          <option value="{{owner.id}}" {{#if owner.selected}}selected{{/if}}>{{owner.name}}</option>
          {{/each}}
        </select>
        <button type="button" data-action="setPetOwner" class="pet-owner-apply">{{localize "EQRPG.Assign"}}</button>
      </div>
      {{/if}}
    </div>

    <div class="header-resources pet-resource-row">
      <div class="resource hp">
        <label>{{localize "EQRPG.HP"}}</label>
        <div class="resource-bar">
          <input type="number" name="system.resources.hp.value" value="{{system.resources.hp.value}}"
                 {{#unless isEditable}}disabled{{/unless}} />
          <span class="separator">/</span>
          <input type="number" name="system.resources.hp.max" value="{{system.resources.hp.max}}"
                 {{#unless isEditable}}disabled{{/unless}} />
        </div>
      </div>
      <div class="resource temp-hp">
        <label>{{localize "EQRPG.TempHP"}}</label>
        <div class="resource-bar">
          <input type="number" name="system.resources.hp.temp" value="{{system.resources.hp.temp}}"
                 min="0" {{#unless isEditable}}disabled{{/unless}} />
        </div>
      </div>
      <div class="resource mana">
        <label>{{localize "EQRPG.Mana"}}</label>
        <div class="resource-bar">
          <input type="number" name="system.resources.mana.value" value="{{system.resources.mana.value}}"
                 {{#unless isEditable}}disabled{{/unless}} />
          <span class="separator">/</span>
          <input type="number" name="system.resources.mana.max" value="{{system.resources.mana.max}}"
                 {{#unless isEditable}}disabled{{/unless}} />
        </div>
      </div>
      <div class="npc-quick-stats pet-quick-stats">
        <div class="npc-quick-stat">
          <span class="quick-stat-label">{{localize "EQRPG.ArmorClass"}}</span>
          <span class="quick-stat-value">{{system.combat.ac.value}}</span>
        </div>
        <button type="button" class="npc-quick-stat pet-roll-stat" data-action="rollInitiative">
          <span class="quick-stat-label">{{localize "EQRPG.Initiative"}}</span>
          <span class="quick-stat-value">{{#if (gte system.combat.initiative.value 0)}}+{{/if}}{{system.combat.initiative.value}}</span>
        </button>
        <div class="npc-quick-stat">
          <span class="quick-stat-label">{{localize "EQRPG.Speed"}}</span>
          <span class="quick-stat-value">{{system.details.speed}} ft.</span>
        </div>
      </div>
    </div>
  </div>
</header>
